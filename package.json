{
  "name": "app",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.11.0"
  },
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "release": "node ./node_modules/typeorm/cli.js migration:run -d ./dist/core/config/migration-data-source.js",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "migration:create": "tsx ./node_modules/typeorm/cli.js migration:create",
    "migration:run": "tsx ./node_modules/typeorm/cli.js migration:run -d ./src/core/config/migration-data-source.ts",
    "migration:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d ./src/core/config/migration-data-source.ts",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d ./src/core/config/migration-data-source.ts",
    "migration:show": "tsx ./node_modules/typeorm/cli.js migration:show -d ./src/core/config/migration-data-source.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.5.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/mapped-types": "^12.0.1",
    "@nestjs/platform-express": "^12.5.1",
    "@nestjs/schedule": "^12.0.4",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/typeorm": "^12.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.1",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "openai": "^7.57.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/mau": "^0.2.9",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
