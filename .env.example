#IA
IA_TOKEN=<SECRET_PLACEHOLDER>
IA_MODEL_VISION=IA_MODEL_VISION
IA_MODEL=IA_MODEL
URL_IA=DOMAIN.COM

# Base de datos MySQL
DB_HOST=<DB_HOST>
DB_PORT=<PORT>
DB_USER=<USER>
DB_PASSWORD=<SECRET_PLACEHOLDER>
DB_NAME=<DB_NAME>
DB_POOL_LIMIT=<LIMIT>
DB_LOGGING=<BOOLEAN>

# Firebase Admin (Service Account). Copiar desde Firebase Console.
# El private key puede ir en una sola linea con \n o en base64.
FIREBASE_PROJECT_ID=<SECRET_PLACEHOLDER>
FIREBASE_CLIENT_EMAIL=<SECRET_PLACEHOLDER>
FIREBASE_PRIVATE_KEY="<SECRET_PLACEHOLDER>

# Sesion JWT (cookie HTTP-ONLY). Usar un secreto largo y aleatorio.
JWT_SECRET=<SECRET_PLACEHOLDER>
JWT_EXPIRES_IN=<TIME>
JWT_ACCESS_EXPIRES_IN=<TIME_MIN>
MAX_AGE=<TIEMPO_MAXIMO>


TIME_PURGE_RF_TOKEN=<PURGE_MS>

# CORS: origins del frontend separados por coma
CORS_ORIGIN=<ORIGEN>

# Limite diario gratuito de mensajes de IA por usuario
AI_DAILY_LIMIT=<LIMIT>

# Entorno: development | production
NODE_ENV=development

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=<NAME>
CLOUDINARY_API_KEY=<API_KEY>
CLOUDINARY_API_SECRET=<API_SECRET>