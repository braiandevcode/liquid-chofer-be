#IA
IA_TOKEN=<SECRET_PLACEHOLDER>
IA_MODEL_VISION=IA_MODEL_VISION
IA_MODEL=IA_MODEL
URL_IA=DOMAIN.COM

# Base de datos MySQL
DB_HOST=<DB_HOST>
DB_PORT=<PORT>
DB_USER=<USER>
DB_PASSWORD=<SECRET_PLACEHOLDER>
DB_NAME=<DB_NAME>
DB_POOL_LIMIT=<LIMIT>
DB_LOGGING=<BOOLEAN>

# FIREBASE ADMIN (COPIAR DESDE FIREBASE CONSOLE)
FIREBASE_PROJECT_ID=<SECRET_PLACEHOLDER>
FIREBASE_CLIENT_EMAIL=<SECRET_PLACEHOLDER>
FIREBASE_PRIVATE_KEY="<SECRET_PLACEHOLDER>

# SESSION JWT
JWT_SECRET=<SECRET_PLACEHOLDER>
JWT_EXPIRES_IN=<TIME>
JWT_ACCESS_EXPIRES_IN=<TIME_MIN>
MAX_AGE=<TIEMPO_MAXIMO>

# CORS
CORS_ORIGIN=<ORIGEN>

# LIMITE DIARIO DE MENSAJES AL ASISTENTE IA POR USUARIO
AI_DAILY_LIMIT=<LIMIT>

# ENTORNO: development | production
NODE_ENV=development

# CLOUDINARY
CLOUDINARY_CLOUD_NAME=<NAME>
CLOUDINARY_API_KEY=<API_KEY>
CLOUDINARY_API_SECRET=<API_SECRET>

# PURGE
TIME_PURGE_RF_TOKEN=<PURGE_MS>

# TAMAÑO DE LOTES
BATCH_SIZE=<BATCH_SIZE>

# RETENCION DE PAPELERA
RETENTION_DAYS=<RETENTIONS>

# DIAS EN MILISEGUNDOS
DAY_MS=<DAY_MS>